<Window x:Class="ZixCafe.Client.Agent.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair this terminal"
        Width="420" Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PAIR THIS TERMINAL" Style="{StaticResource DisplayHeading}" FontSize="16" />
        <TextBlock Grid.Row="1" Margin="0,4,0,16" TextWrapping="Wrap" Opacity="0.8"
                   Style="{StaticResource BodyText}" FontSize="12"
                   Foreground="{StaticResource GhostBrush}"
                   Text="Ask the front desk for a 6-digit pairing code. It expires in 10 minutes and works once." />

        <TextBlock Grid.Row="2" Text="FRONT DESK SERVER" Style="{StaticResource CapsLabel}" />
        <TextBox x:Name="ServerUrlBox" Grid.Row="3" Style="{StaticResource AppTextBox}" Margin="0,6,0,16" />

        <TextBlock Grid.Row="4" Text="PAIRING CODE" Style="{StaticResource CapsLabel}" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}" Width="140" MaxLength="6"
                     FontFamily="{StaticResource DataFont}" FontSize="20" HorizontalContentAlignment="Center" />
            <Button x:Name="PairButton" Content="Pair" Style="{StaticResource GoldButton}"
                    Margin="12,0,0,0" VerticalAlignment="Stretch" Click="Pair_Click" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="6" Style="{StaticResource BodyText}" FontSize="12"
                   Foreground="{StaticResource AlertBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</Window>
