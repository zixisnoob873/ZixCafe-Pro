<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Type (DESIGN.md): Chakra Petch 600 display, IBM Plex Sans 400/500 body,
    JetBrains Mono 500 data. Composite fallback strings until OFL TTFs are
    bundled into Assets/Fonts before release.
    -->

    <FontFamily x:Key="DisplayFont">Chakra Petch, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">IBM Plex Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="DataFont">JetBrains Mono, Consolas</FontFamily>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="DisplaySize">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="TitleSize">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="BodySize">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="SmallSize">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="MicroSize">11</sys:Double>
</ResourceDictionary>
