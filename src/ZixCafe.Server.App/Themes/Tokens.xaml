<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ZixCafe Pro Enterprise SaaS Design Tokens — Minimalist Slate & Indigo (Linear / Fluent Aesthetic)
    -->

    <!-- Core Surfaces & Backgrounds -->
    <Color x:Key="VoidColor">#090D16</Color>
    <Color x:Key="PanelColor">#0F172A</Color>
    <Color x:Key="RaisedColor">#1E293B</Color>
    <Color x:Key="HoverColor">#283548</Color>
    <Color x:Key="SelectedColor">#334155</Color>

    <!-- Hairline Borders & Dividers -->
    <Color x:Key="LineColor">#334155</Color>
    <Color x:Key="LineSubtleColor">#1E293B</Color>

    <!-- Typography Text Colors -->
    <Color x:Key="InkColor">#F8FAFC</Color>
    <Color x:Key="GhostColor">#94A3B8</Color>
    <Color x:Key="MutedColor">#64748B</Color>

    <!-- Primary Accent: Refined Indigo / Cobalt -->
    <Color x:Key="BrandColor">#6366F1</Color>
    <Color x:Key="BrandDeepColor">#4F46E5</Color>
    <Color x:Key="BrandSubtleColor">#1E1B4B</Color>
    <Color x:Key="GoldColor">#6366F1</Color>
    <Color x:Key="GoldDeepColor">#4F46E5</Color>
    <Color x:Key="GoldSubtleColor">#1E1B4B</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="RunColor">#10B981</Color>
    <Color x:Key="RunSubtleColor">#064E3B</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <Color x:Key="WarnSubtleColor">#451A03</Color>
    <Color x:Key="AlertColor">#EF4444</Color>
    <Color x:Key="AlertSubtleColor">#450A0A</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <Color x:Key="InfoSubtleColor">#082F49</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />

    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineSubtleBrush" Color="{StaticResource LineSubtleColor}" />

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="GhostBrush" Color="{StaticResource GhostColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandDeepBrush" Color="{StaticResource BrandDeepColor}" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="{StaticResource BrandSubtleColor}" />

    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="GoldDeepBrush" Color="{StaticResource BrandDeepColor}" />
    <SolidColorBrush x:Key="GoldSubtleBrush" Color="{StaticResource BrandSubtleColor}" />

    <SolidColorBrush x:Key="RunBrush" Color="{StaticResource RunColor}" />
    <SolidColorBrush x:Key="RunSubtleBrush" Color="{StaticResource RunSubtleColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSubtleBrush" Color="{StaticResource WarnSubtleColor}" />
    <SolidColorBrush x:Key="AlertBrush" Color="{StaticResource AlertColor}" />
    <SolidColorBrush x:Key="AlertSubtleBrush" Color="{StaticResource AlertSubtleColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource InfoSubtleColor}" />

    <SolidColorBrush x:Key="TextOnGoldBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFF" />

    <!-- Geometry / Dimensions (8px Grid Hierarchy) -->
    <Thickness x:Key="HairlineThickness">1</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="TileRadius">8</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="InputRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>
    <GridLength x:Key="NavWidth">240</GridLength>
</ResourceDictionary>
