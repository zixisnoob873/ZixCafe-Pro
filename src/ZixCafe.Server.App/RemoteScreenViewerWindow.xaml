<Window x:Class="ZixCafe.Server.App.RemoteScreenViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Screen View — Technical Assistance"
        Width="960" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="TERMINAL SCREEN VIEW" Style="{StaticResource DisplayHeading}" FontSize="13" VerticalAlignment="Center" />
                    <Border Margin="12,0,0,0" Background="#33FBBF24" CornerRadius="3" Padding="8,2">
                        <TextBlock Text="ANNOUNCED TO USER" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh Frame" Style="{StaticResource GhostButton}" Click="Refresh_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#050505">
            <Image x:Name="ScreenImage" Stretch="Uniform" />
            <TextBlock x:Name="StatusText" Text="Requesting initial screen frame..." Style="{StaticResource BodyText}"
                       Foreground="{StaticResource GhostBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Captures are encrypted and announced to maintain guest privacy."
                           Style="{StaticResource BodyText}" FontSize="11" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Close" Style="{StaticResource GhostButton}" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
