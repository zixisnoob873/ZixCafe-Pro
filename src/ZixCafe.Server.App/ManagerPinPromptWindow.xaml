<Window x:Class="ZixCafe.Server.App.ManagerPinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Authorization Required"
        Width="400" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ThreeDBorderWindow"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MANAGER AUTHORIZATION" Style="{StaticResource DisplayHeading}" FontSize="15" Foreground="{StaticResource GoldBrush}" />
            <TextBlock x:Name="ReasonText" Text="This action requires a Manager or Admin PIN override."
                       Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource GhostBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Separator Grid.Row="1" Background="{StaticResource LineBrush}" Margin="0,12,0,16" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="ENTER MANAGER PIN" Style="{StaticResource CapsLabel}" />
            <PasswordBox x:Name="PinBox" MaxLength="16"
                         Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                         Padding="10,6" Margin="0,6,0,0" KeyDown="PinBox_KeyDown" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" FontSize="11" Foreground="{StaticResource AlertBrush}"
                       Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Grid.Column="2" Content="Authorize" Style="{StaticResource GoldButton}" Click="Authorize_Click" />
        </Grid>
    </Grid>
</Window>
