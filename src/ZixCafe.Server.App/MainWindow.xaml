<Window x:Class="ZixCafe.Server.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rack="clr-namespace:ZixCafe.Server.App.Rack"
        Title="ZixCafe Pro — Server"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource NavWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,8" Orientation="Horizontal">
                    <Path Width="26" Height="26" Fill="{StaticResource GoldBrush}"
                          Data="{StaticResource ZixBoltGeometry}" Stretch="Uniform" />
                    <TextBlock Margin="10,0,0,0" Text="ZIXCAFE PRO" VerticalAlignment="Center"
                               Style="{StaticResource DisplayHeading}" FontSize="15"
                               Foreground="{StaticResource InkBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavRack" GroupName="nav" IsChecked="True" Content="Rack"
                                 Style="{StaticResource NavButton}" Checked="NavRack_Checked" />
                    <RadioButton x:Name="NavDesk" GroupName="nav" Content="Desk"
                                 Style="{StaticResource NavButton}" Checked="NavDesk_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="16,0,16,16">
                    <TextBlock x:Name="CashierText" Text="—" Style="{StaticResource CapsLabel}" FontSize="10"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="SERVER  ·  PORT 40000" Style="{StaticResource CapsLabel}" FontSize="10"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="HealthText" Text="STARTING" Style="{StaticResource MonoData}"
                               Margin="0,4,0,0" FontSize="12"
                               Foreground="{StaticResource GoldBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="RackView" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource VoidBrush}">
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rack" Style="{StaticResource DisplayHeading}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Pair Terminal" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="PairTerminal_Click" />
                    <Button Grid.Column="2" Content="Lock All" Style="{StaticResource GhostButton}"
                            Click="LockAll_Click" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RackItems" Margin="24,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <rack:TerminalTile DataContext="{Binding}" MouseLeftButtonUp="Tile_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DeskView" Grid.Column="1" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="24,20">

                    <TextBlock Text="Shift" Style="{StaticResource DisplayHeading}" />
                    <TextBlock x:Name="ShiftStatusText" Margin="0,6,0,0" Style="{StaticResource MonoData}"
                               FontSize="12" Text="NO SHIFT OPEN" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OpenShiftButton" Content="Open Shift…" Style="{StaticResource GoldButton}"
                                Click="OpenShift_Click" />
                        <Button x:Name="CloseShiftButton" Grid.Column="1" Content="Close Shift…" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}" Click="CloseShift_Click" IsEnabled="False" />
                    </Grid>

                    <TextBlock Text="WAITLIST" Style="{StaticResource CapsLabel}" Margin="0,28,0,8" />
                    <ItemsControl x:Name="WaitlistItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RaisedBrush}" Padding="12,8" Margin="0,0,0,6"
                                        CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                       Text="{Binding GuestName}" />
                                            <TextBlock Style="{StaticResource MonoData}" FontSize="11"
                                                       Foreground="{StaticResource GhostBrush}">
                                                <Run Text="{Binding PartySize, Mode=OneWay}" /><Run Text=" p · since " /><Run Text="{Binding EnqueuedAt.Hour, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding EnqueuedAt.Minute, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Seat…" Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0" Click="SeatGuest_Click" />
                                        <Button Grid.Column="2" Content="Skip" Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0" Click="SkipGuest_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WaitNameInput" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="12" />
                        <TextBox x:Name="WaitPartyInput" Grid.Column="2" Width="44" Text="1" MaxLength="2" FontSize="12" />
                        <TextBox x:Name="WaitContactInput" Grid.Column="4" Style="{StaticResource AppTextBox}"
                                 MaxLength="120" FontSize="12" />
                        <Button x:Name="AddWaitGuestButton" Grid.Column="6" Content="Add" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Click="AddWaitGuest_Click" />
                    </Grid>

                    <TextBlock Text="LOANS OUT" Style="{StaticResource CapsLabel}" Margin="0,28,0,8" />
                    <ItemsControl x:Name="LoanItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RaisedBrush}" Padding="12,8" Margin="0,0,0,6"
                                        CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                       Text="{Binding ItemName}" />
                                            <TextBlock Style="{StaticResource MonoData}" FontSize="11"
                                                       Foreground="{StaticResource GhostBrush}">
                                                <Run Text="deposit " /><Run Text="{Binding DepositAmount, Mode=OneWay}" /><Run Text=" · held by " /><Run Text="{Binding HeldBy, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Returned" Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0" Click="ReturnLoan_Click" />
                                        <Button Grid.Column="2" Content="Forfeit" Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0" Click="ForfeitLoan_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LoanItemInput" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="12" />
                        <TextBox x:Name="LoanDepositInput" Grid.Column="2" Width="64" Text="0" MaxLength="8" FontSize="12" />
                        <TextBox x:Name="LoanHeldInput" Grid.Column="4" Width="110" MaxLength="120" FontSize="12" />
                        <Button x:Name="LoanItemButton" Grid.Column="6" Content="Loan Out" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Click="LoanItem_Click" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="InspectorPanel" Grid.Column="2" Width="280" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="InspectorName" Text="—" Style="{StaticResource DisplayHeading}" FontSize="18" />
                <StackPanel Grid.Row="1" Margin="0,2,0,0">
                    <TextBlock x:Name="InspectorZone" Text="—" Style="{StaticResource CapsLabel}" />
                    <TextBlock x:Name="InspectorStatus" Margin="0,8,0,0" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="InspectorSession" Margin="0,4,0,0" Style="{StaticResource BodyText}"
                               FontSize="12" Foreground="{StaticResource GhostBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="CHAT" Style="{StaticResource CapsLabel}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ChatItems" MaxHeight="150"
                                  VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}" FontSize="12">
                                    <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{StaticResource GoldBrush}" />
                                    <Run Text="{Binding Message, Mode=OneWay}"
                                         Foreground="{StaticResource InkBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" MaxLength="300" FontSize="12" />
                        <Button x:Name="ChatSendButton" Grid.Column="1" Content="Send"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="ChatSend_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="START SESSION" Style="{StaticResource CapsLabel}" Margin="0,0,0,8" />
                    <Button Content="Walk-up (postpaid)" Style="{StaticResource GoldButton}"
                            HorizontalAlignment="Stretch" Click="StartPostpaid_Click" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="30 min" Style="{StaticResource GhostButton}" Click="StartPrepaid30_Click" />
                        <Button Grid.Column="2" Content="60 min" Style="{StaticResource GhostButton}" Click="StartPrepaid60_Click" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="120 min" Style="{StaticResource GhostButton}" Click="StartPrepaid120_Click" />
                        <Button x:Name="RedeemCodeButton" Grid.Column="2" Content="Redeem code…"
                                Style="{StaticResource GhostButton}" Click="RedeemCode_Click" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MemberQueryInput" MaxLength="40" FontSize="12"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Member…" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="MemberStart_Click" />
                    </Grid>

                    <TextBlock Text="CONTROL" Style="{StaticResource CapsLabel}" Margin="0,24,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseResumeButton" Content="Pause" Style="{StaticResource GhostButton}"
                                Click="PauseResume_Click" />
                        <Button x:Name="EndSessionButton" Grid.Column="2" Content="End Session" Style="{StaticResource GoldButton}"
                                Click="EndSession_Click" />
                    </Grid>
                    <Button Content="Lock Terminal" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="LockTerminal_Click" />

                    <TextBlock Text="SELL ITEM" Style="{StaticResource CapsLabel}" Margin="0,24,0,8" />
                    <ComboBox x:Name="ProductPicker" FontSize="12"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Add to session" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" Click="AddProduct_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
