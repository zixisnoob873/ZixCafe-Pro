                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SIGNALR PORT" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgSignalRPort" Text="40000" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="WOL SUBNET" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgWolSubnet" Text="255.255.255.255" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="WOL PORT" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgWolPort" Text="9" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ROUTER TYPE" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <ComboBox x:Name="CfgRouterType" FontSize="11" Margin="0,2,0,0">
                                                <ComboBoxItem Content="None" IsSelected="True" />
                                                <ComboBoxItem Content="MikroTik" />
                                                <ComboBoxItem Content="OpenWrt" />
                                                <ComboBoxItem Content="PFSense" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ROUTER IP" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgRouterIp" Text="192.168.1.1" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="GUEST BANDWIDTH LIMIT (MBPS)" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgBandwidthLimit" Text="50" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MQTT BROKER" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgMqttHost" Text="tcp://localhost" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="MQTT PORT" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgMqttPort" Text="1883" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="MQTT USERNAME" Style="{StaticResource CapsLabel}" FontSize="9" />
                                            <TextBox x:Name="CfgMqttUser" Text="zixcafe" Style="{StaticResource AppTextBox}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="Reset Category Defaults" Tag="network" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="ResetCategoryConfig_Click" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 7: Cashiers & Access Control -->
                            <GroupBox Header="7. CASHIERS &amp; ACCESS CONTROL" Margin="0,16,0,0">
                                <StackPanel>
                                    <DataGrid x:Name="CashiersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                                              BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                                              AlternatingRowBackground="{StaticResource RaisedBrush}" MaxHeight="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" />
                                            <DataGridTextColumn Header="Display Name" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                                            <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewCashierUsername" Style="{StaticResource AppTextBox}" MaxLength="60" FontSize="11" />
                                        <TextBox x:Name="NewCashierName" Grid.Column="2" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="11" />
                                        <PasswordBox x:Name="NewCashierPin" Grid.Column="4" MaxLength="8" FontSize="11" />
                                        <ComboBox x:Name="NewCashierRole" Grid.Column="6" FontSize="11" />
                                        <Button Grid.Column="8" Content="Create Cashier" Style="{StaticResource GhostButton}" Click="AddCashier_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 8: Tariffs Matrix -->
                            <GroupBox Header="8. HOURLY TARIFFS &amp; PRICING RULES" Margin="0,16,0,0">
                                <StackPanel>
                                    <DataGrid x:Name="TariffsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                                              BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                                              AlternatingRowBackground="{StaticResource RaisedBrush}" MaxHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tariff Name" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Base Rate / Hr" Binding="{Binding BaseRatePerHour, StringFormat={}{0:C}}" Width="110" />
                                            <DataGridTextColumn Header="Min Minutes" Binding="{Binding MinDurationMinutes}" Width="90" />
                                            <DataGridTextColumn Header="Rounding (Min)" Binding="{Binding RoundingMinutes}" Width="100" />
                                            <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="70" />
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewTariffName" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="11" />
                                        <TextBox x:Name="NewTariffRate" Grid.Column="2" Style="{StaticResource AppTextBox}" Text="5.00" FontSize="11" />
                                        <TextBox x:Name="NewTariffMinMin" Grid.Column="4" Style="{StaticResource AppTextBox}" Text="15" FontSize="11" />
                                        <TextBox x:Name="NewTariffRounding" Grid.Column="6" Style="{StaticResource AppTextBox}" Text="5" FontSize="11" />
                                        <Button Grid.Column="8" Content="Save Tariff" Style="{StaticResource GhostButton}" Click="AddTariff_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 9: Database Backups & Recovery -->
                            <GroupBox Header="9. DATABASE SNAPSHOTS &amp; RECOVERY" Margin="0,16,0,32">
                                <StackPanel>
                                    <TextBlock x:Name="DatabaseInfoText" Text="Database: SQLite · Status: Connected" Style="{StaticResource MonoData}" FontSize="11" Foreground="{StaticResource GhostBrush}" />
                                    <TextBlock x:Name="BackupStatusText" Text="Ready for snapshot." Style="{StaticResource MonoData}" FontSize="10.5" Foreground="{StaticResource GoldBrush}" Margin="0,4,0,0" />
                                    <Grid Margin="0,10,0,0">
                                        <Button Content="Create Instant Backup" Style="{StaticResource GoldButton}" HorizontalAlignment="Left" Click="BackupDatabase_Click" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Export DB Backup…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ExportBackup_Click" />
                                            <Button Content="Restore From File…" Style="{StaticResource GhostButton}" Click="RestoreFromFile_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid x:Name="BackupsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                                              BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                                              AlternatingRowBackground="{StaticResource RaisedBrush}" MaxHeight="160" Margin="0,10,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Backup File" Binding="{Binding FileName}" Width="250" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                            <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                                            <DataGridTemplateColumn Header="Action" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Restore" Tag="{Binding FullPath}" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="10" Click="RestoreGridBackup_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================================================================= -->
                <!-- BOTTOM SPLIT REAL-TIME LOG & CHAT CONSOLE                         -->
                <!-- ================================================================= -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <!-- TAB 1: LIVE EVENT LOG CONSOLE -->
                        <TabItem Header="Live Event Log">
                            <Grid>
                                <ScrollViewer x:Name="LiveEventLogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12,6">
                                    <ItemsControl x:Name="LiveEventLogsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Timestamp}" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GhostBrush}" />
                                                    <TextBlock Grid.Column="1" Text="→" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource LineBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource MonoData}" FontSize="10" Foreground="{Binding ColorBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: TERMINAL MESSAGES & CHAT THREAD -->
                        <TabItem Header="Messages &amp; Chat">
                            <Grid Margin="12,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ChatItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1" TextWrapping="Wrap" Style="{StaticResource BodyText}" FontSize="10.5">
                                                    <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                                    <Run Text=": " Foreground="{StaticResource GhostBrush}" />
                                                    <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource InkBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChatInput" MaxLength="300" FontSize="11" Style="{StaticResource AppTextBox}" />
                                    <Button x:Name="ChatSendButton" Grid.Column="1" Content="Send" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ChatSend_Click" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 3: BOTTOM TELEMETRY STATUS BAR                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" Background="{StaticResource RaisedBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Cashier -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <!-- Counts -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <!-- Occupancy Progress Meter -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Server & Version -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CashierText" Grid.Column="0" Text="CASHIER: ADMIN · OWNER" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="TotalTerminalsText" Grid.Column="2" Text="TOTAL: 35" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="InUseCountText" Grid.Column="4" Text="IN USE: 0" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource RunBrush}" FontWeight="Bold" VerticalAlignment="Center" />

                <TextBlock x:Name="IdleCountText" Grid.Column="6" Text="IDLE: 35" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" />

                <!-- Occupancy Ratio Progress Meter -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OCCUPANCY:" Style="{StaticResource CapsLabel}" FontSize="9" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ProgressBar x:Name="OccupancyProgressBar" Width="100" Height="8" Value="0" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock x:Name="OccupancyRatioText" Text="0%" Style="{StaticResource MonoData}" FontSize="9.5" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Server Port & Version -->
                <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HealthText" Text="SERVER · PORT 40000 · ONLINE" Style="{StaticResource MonoData}" FontSize="9.5" Foreground="{StaticResource RunBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="v1.0.0 COMMERCIAL" Style="{StaticResource MonoData}" FontSize="9" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
