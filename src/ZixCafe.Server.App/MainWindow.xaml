<Window x:Class="ZixCafe.Server.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rack="clr-namespace:ZixCafe.Server.App.Rack"
        Title="ZixCafe Pro — Equilibrium Command Center"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Application Ribbon & Digital Clock -->
            <RowDefinition Height="Auto" />
            <!-- 1: Sub-Toolbar Fast Action Command Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Operational Split Area -->
            <RowDefinition Height="*" />
            <!-- 3: Bottom Telemetry Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP APPLICATION MODULE RIBBON & LIVE DIGITAL CLOCK                 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="12,6,16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand Wordmark -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Module Navigation Ribbon -->
                    <ColumnDefinition Width="*" />
                    <!-- Live Digital Clock & Date -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Branding Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0">
                    <Path Width="24" Height="24" Fill="{StaticResource GoldBrush}"
                          Data="{StaticResource ZixBoltGeometry}" Stretch="Uniform" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ZIXCAFE PRO" Style="{StaticResource DisplayHeading}" FontSize="15" Foreground="{StaticResource InkBrush}" />
                        <TextBlock x:Name="LicenseRibbonText" Text="COMMERCIAL EDITION" Style="{StaticResource MonoData}" FontSize="8.5" Foreground="{StaticResource GoldBrush}" />
                    </StackPanel>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{StaticResource LineBrush}" Margin="16,4" />
                </StackPanel>

                <!-- Top Module Navigation Ribbon RadioButtons -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NavRack" GroupName="nav" IsChecked="True" Style="{StaticResource RibbonNavButton}" Checked="NavRack_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconHome}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Home / Rack (F1)" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavDesk" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavDesk_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconCoin}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Desk &amp; Shifts" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSales" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavSales_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconCafe}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Cafeteria / POS (F5)" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTickets" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavTickets_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconTicket}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Tickets / Vouchers" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavMembers" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavMembers_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconMembers}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Members Club" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavInventory" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavInventory_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconInventory}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Inventory" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavPeripherals" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavPeripherals_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconPrinter}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Print &amp; USB" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavReports" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavReports_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconChart}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Reports &amp; Audit" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAlerts" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavAlerts_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconAlert}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Alerts Center" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource RibbonNavButton}" Checked="NavSettings_Checked">
                            <StackPanel HorizontalAlignment="Center" Margin="6,2">
                                <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconGear}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock Text="Settings" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Button Style="{StaticResource ActionToolbarButton}" Margin="6,0,0,0" Padding="8,4" Click="OpenWebDashboard_Click" ToolTip="Open LAN Web Dashboard">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="14" Height="14" Fill="{StaticResource GoldBrush}" Data="{StaticResource IconScreen}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="LAN Mirror" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Live Digital Clock & Full Date Header -->
                <Border Grid.Column="2" Background="{StaticResource RaisedBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LiveClockText" Text="21:41:56" Style="{StaticResource MonoData}"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="LiveDateText" Text="Tuesday, 1 September 2026" Style="{StaticResource CapsLabel}"
                                   FontSize="8.5" Foreground="{StaticResource GhostBrush}"
                                   HorizontalAlignment="Right" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: SUB-TOOLBAR FAST ACTION COMMAND BAR                                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="{StaticResource RaisedBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="12,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Session Controls -->
                    <TextBlock Text="SESSION:" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="▶ Postpaid (F2)" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="StartPostpaid_Click" ToolTip="Start walk-up postpaid session on selected terminal" />
                    <Button Content="⏱ 30m" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="StartPrepaid30_Click" ToolTip="Start 30 minute prepaid session" />
                    <Button Content="⏱ 60m" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="StartPrepaid60_Click" ToolTip="Start 60 minute prepaid session" />
                    <Button Content="⏱ 120m" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="StartPrepaid120_Click" ToolTip="Start 120 minute prepaid session" />
                    <Button Content="👤 Member" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="MemberStart_Click" ToolTip="Start session with member account" />
                    <Button Content="⏸ Pause/Resume (F3)" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="PauseResume_Click" ToolTip="Pause or resume selected session" />
                    <Button Content="⏹ End (F4)" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Background="{StaticResource GoldBrush}" Foreground="{StaticResource VoidBrush}" Click="EndSession_Click" ToolTip="End session and calculate final bill" />

                    <Separator Background="{StaticResource LineBrush}" Margin="8,2" />

                    <!-- Power & System Controls -->
                    <TextBlock Text="POWER &amp; FLOOR:" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="⚡ Wake (WoL)" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="WakeWoL_Click" ToolTip="Send Wake-on-LAN packet to selected PC" />
                    <Button Content="⚡ Wake All" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="WakeAllWoL_Click" ToolTip="Send Wake-on-LAN to all offline machines" />
                    <Button Content="🔄 Reboot" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="RebootTerminal_Click" ToolTip="Remotely reboot selected machine" />
                    <Button Content="🔒 Lock PC" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="LockTerminal_Click" ToolTip="Lock selected PC screen" />
                    <Button Content="🔒 Lock All Floor" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="LockAll_Click" ToolTip="Lock all workstations on the floor" />

                    <Separator Background="{StaticResource LineBrush}" Margin="8,2" />

                    <!-- Diagnostics & Monitoring -->
                    <TextBlock Text="DIAGNOSTICS:" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="🖥 Screen View" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="ViewScreen_Click" ToolTip="Open remote screen stream for selected PC" />
                    <Button Content="💬 Chat (F8)" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="ChatTerminal_Click" ToolTip="Send broadcast or direct chat message" />
                    <Button Content="🔌 Smart Relay" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="TogglePowerRelay_Click" ToolTip="Toggle AC power relay for workstation desk" />
                    <Button Content="🛡️ Kill Prohibited" Style="{StaticResource ActionToolbarButton}" Margin="0,0,4,0" Click="TriggerDisklessWipe_Click" ToolTip="Terminate unauthorized background tasks &amp; wipe temporary files" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: MAIN OPERATIONAL WORKSPACE (LEFT DOCK + CENTER VIEW + BOTTOM LOG) -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Inspector Tabbed Dock -->
                <ColumnDefinition Width="290" />
                <!-- Center Workspace & Bottom Event Log Split -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- LEFT DOCKED INSPECTOR TABBED PANEL                                    -->
            <!-- ===================================================================== -->
            <Border x:Name="InspectorPanel" Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Inspector Header & Close -->
                        <RowDefinition Height="Auto" />
                        <!-- Inspector Body Tabs -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Inspector Header -->
                    <Border Grid.Row="0" Background="{StaticResource VoidBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="14" Height="14" Fill="{StaticResource GoldBrush}" Data="{StaticResource IconTerminal}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="TERMINAL INSPECTOR" Style="{StaticResource CapsLabel}" FontSize="11" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource SmallActionButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="CloseInspector_Click" />
                        </Grid>
                    </Border>

                    <!-- Inspector Tab Control -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,2,0,0">
                        <!-- TAB 1: GENERAL & TELEMETRY -->
                        <TabItem Header="General" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                <StackPanel>
                                    <!-- Workstation Header -->
                                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10" CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="InspectorName" Text="NO SELECTION" Style="{StaticResource DisplayHeading}" FontSize="16" Foreground="{StaticResource GoldBrush}" />
                                                <TextBlock x:Name="InspectorStatus" Text="READY" Style="{StaticResource CapsLabel}" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="InspectorZone" Text="Zone: Main Gaming Floor" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" Margin="0,3,0,0" />
                                            <TextBlock x:Name="InspectorTelemetry" Text="CPU: 32°C · RAM: 24% · DISK: 240GB" Style="{StaticResource MonoData}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Active Session Summary -->
                                    <Border Margin="0,10,0,0" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE SESSION" Style="{StaticResource CapsLabel}" FontSize="9" Foreground="{StaticResource GhostBrush}" />
                                            <TextBlock x:Name="InspectorSession" Margin="0,4,0,0" Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock x:Name="InspectorCharge" Text="Current: $0.00" Style="{StaticResource MonoData}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Fast Session Controls -->
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="QUICK ACTIONS" Style="{StaticResource CapsLabel}" FontSize="9" Foreground="{StaticResource GhostBrush}" Margin="0,0,0,4" />
                                        <Button Content="Start Walk-up (F2)" Style="{StaticResource GoldButton}" HorizontalAlignment="Stretch" Click="StartPostpaid_Click" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="30m Prepaid" Style="{StaticResource GhostButton}" Click="StartPrepaid30_Click" />
                                            <Button Grid.Column="2" Content="60m Prepaid" Style="{StaticResource GhostButton}" Click="StartPrepaid60_Click" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="120m Prepaid" Style="{StaticResource GhostButton}" Click="StartPrepaid120_Click" />
                                            <Button x:Name="RedeemCodeButton" Grid.Column="2" Content="Redeem Code…" Style="{StaticResource GhostButton}" Click="RedeemCode_Click" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MemberQueryInput" Style="{StaticResource AppTextBox}" FontSize="11" VerticalContentAlignment="Center" />
                                            <Button Grid.Column="1" Content="Member" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="MemberStart_Click" />
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PauseResumeButton" Content="Pause (F3)" Style="{StaticResource GhostButton}" Click="PauseResume_Click" />
                                            <Button x:Name="EndSessionButton" Grid.Column="2" Content="End (F4)" Style="{StaticResource GoldButton}" Click="EndSession_Click" />
                                        </Grid>
                                        <Button x:Name="SwitchStationButton" Content="Switch Station…" Style="{StaticResource GhostButton}" Margin="0,4,0,0" Click="SwitchStation_Click" />
                                    </StackPanel>

                                    <!-- Hardware & Anti-Theft Baseline -->
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="HARDWARE &amp; INTEGRITY" Style="{StaticResource CapsLabel}" FontSize="9" Foreground="{StaticResource GhostBrush}" Margin="0,0,0,4" />
                                        <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock x:Name="InspectorHwCpuGpu" Text="CPU/GPU: Scanning..." Style="{StaticResource MonoData}" FontSize="9.5" TextWrapping="Wrap" />
                                                <TextBlock x:Name="InspectorHwRamDisk" Text="RAM/Disk: Scanning..." Style="{StaticResource MonoData}" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock x:Name="InspectorHwDisplay" Text="Display: 240Hz Gaming" Style="{StaticResource MonoData}" FontSize="9.5" Foreground="{StaticResource GoldBrush}" Margin="0,2,0,0" />
                                                <TextBlock x:Name="InspectorHwPeripherals" Text="USB Whitelist: Active" Style="{StaticResource MonoData}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Set Baseline" Style="{StaticResource GhostButton}" FontSize="10" Click="SetHardwareBaseline_Click" />
                                            <Button Grid.Column="2" Content="Force 240Hz" Style="{StaticResource GhostButton}" FontSize="10" Click="EnforceRefreshRate_Click" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Add Snack / Drink to Session -->
                                    <StackPanel Margin="0,10,0,10">
                                        <TextBlock Text="ADD SNACK / DRINK (F6)" Style="{StaticResource CapsLabel}" FontSize="9" Foreground="{StaticResource GhostBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="ProductPicker" FontSize="11" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                        <Button Content="Add to Running Session" Style="{StaticResource GhostButton}" Margin="0,4,0,0" Click="AddProduct_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: ORDERS & BELONGINGS -->
                        <TabItem Header="Orders &amp; Loans" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                <StackPanel>
                                    <TextBlock Text="ATTACHED CAFE ORDERS" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" Margin="0,4,0,4" />
                                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                                        <TextBlock Text="No active orders attached to this workstation." Style="{StaticResource BodyText}" FontSize="11" Foreground="{StaticResource GhostBrush}" />
                                    </Border>

                                    <TextBlock Text="HARDWARE LOANS HELD" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" Margin="0,12,0,4" />
                                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                                        <TextBlock Text="No peripherals currently loaned to this seat." Style="{StaticResource BodyText}" FontSize="11" Foreground="{StaticResource GhostBrush}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: ACTIVITY HISTORY -->
                        <TabItem Header="Audit Logs" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                <StackPanel>
                                    <TextBlock Text="RECENT WORKSTATION EVENTS" Style="{StaticResource CapsLabel}" FontSize="9.5" Foreground="{StaticResource GhostBrush}" Margin="0,4,0,4" />
                                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="• Session started (Alex)" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource RunBrush}" />
                                            <TextBlock Text="• USB Headset connected" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GhostBrush}" Margin="0,3,0,0" />
                                            <TextBlock Text="• Display locked" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GhostBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- ===================================================================== -->
            <!-- CENTER WORKSPACE + BOTTOM SPLIT REAL-TIME CONSOLE                     -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Center Module Views Workspace -->
                    <RowDefinition Height="*" />
                    <!-- Bottom Split Real-Time Event Log & Chat Console -->
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <!-- ================================================================= -->
                <!-- 1. RACK VIEW (TERMINAL GRID / SCREEN VIEW / TELEMETRY)            -->
                <!-- ================================================================= -->
                <Grid x:Name="RackView" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <!-- Sub-View Bar & Filter Controls -->
                        <RowDefinition Height="Auto" />
                        <!-- Visual Items View Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Rack Sub-Navigation & Filter Bar -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                            Background="{StaticResource VoidBrush}" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- View Switcher Tabs -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Search Box -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Zone Filter -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Spacer -->
                                <ColumnDefinition Width="*" />
                                <!-- Action Buttons -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Sub-view Switcher -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="ViewTerminalRack" GroupName="rackSubView" IsChecked="True" Style="{StaticResource RibbonNavButton}" Padding="8,4" Checked="ViewTerminalRack_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconTerminal}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Terminal View" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ViewScreenGrid" GroupName="rackSubView" Style="{StaticResource RibbonNavButton}" Padding="8,4" Checked="ViewScreenGrid_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconScreen}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Screen View" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ViewTelemetryGrid" GroupName="rackSubView" Style="{StaticResource RibbonNavButton}" Padding="8,4" Checked="ViewTelemetryGrid_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconCpu}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Performance" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- Search Box -->
                            <TextBox x:Name="RackSearchBox" Grid.Column="1" Width="170" Style="{StaticResource AppTextBox}"
                                     FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                     TextChanged="RackSearch_TextChanged" />

                            <!-- Zone Filter -->
                            <ComboBox x:Name="RackZoneFilter" Grid.Column="2" Width="140" Margin="8,0,0,0"
                                      VerticalAlignment="Center" FontSize="11"
                                      SelectionChanged="RackZoneFilter_SelectionChanged" />

                            <!-- Right Status Overview Badges -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Pair PC…" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="8,3" Click="PairTerminal_Click" />
                                <Button Content="Lock All" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="8,3" Click="LockAll_Click" />
                                <Button Content="Wake All (WoL)" Style="{StaticResource GhostButton}" Padding="8,3" Click="WakeAllWoL_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Workstations Scroll Area -->
                    <ScrollViewer x:Name="RackItemsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <ItemsControl x:Name="RackItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <rack:TerminalTile MouseLeftButtonUp="Tile_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Screen View Remote Desktop Wall Area -->
                    <ScrollViewer x:Name="ScreenViewScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                        <ItemsControl x:Name="ScreenViewItems" ItemsSource="{Binding ItemsSource, ElementName=RackItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Width="240" Height="150" Margin="0,0,12,12" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="Tile_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource RaisedBrush}" Padding="8,4">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CapsLabel}" FontSize="10" Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CapsLabel}" FontSize="9" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" Background="{StaticResource VoidBrush}">
                                                <Path Width="36" Height="36" Fill="{StaticResource RaisedBrush}" Data="{StaticResource IconScreen}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Text="LIVE FEED ACTIVE" Style="{StaticResource MonoData}" FontSize="9" Foreground="{StaticResource GhostBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Performance Telemetry Meters Area -->
                    <ScrollViewer x:Name="TelemetryScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                        <ItemsControl x:Name="TelemetryViewItems" ItemsSource="{Binding ItemsSource, ElementName=RackItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Width="260" Height="120" Margin="0,0,12,12" CornerRadius="4" Padding="12" Cursor="Hand" MouseLeftButtonUp="Tile_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayHeading}" FontSize="13" Foreground="{StaticResource GoldBrush}" />
                                                <TextBlock Text="{Binding ZoneName}" Style="{StaticResource CapsLabel}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <Grid Margin="0,4,0,2">
                                                    <TextBlock Text="CPU LOAD / TEMP" Style="{StaticResource CapsLabel}" FontSize="8.5" />
                                                    <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0}°C'}" Style="{StaticResource MonoData}" FontSize="9" HorizontalAlignment="Right" Foreground="{StaticResource RunBrush}" />
                                                </Grid>
                                                <ProgressBar Value="35" Maximum="100" Height="6" />

                                                <Grid Margin="0,6,0,2">
                                                    <TextBlock Text="RAM USAGE" Style="{StaticResource CapsLabel}" FontSize="8.5" />
                                                    <TextBlock Text="{Binding RamPercent, StringFormat='{}{0}%'}" Style="{StaticResource MonoData}" FontSize="9" HorizontalAlignment="Right" Foreground="{StaticResource GoldBrush}" />
                                                </Grid>
                                                <ProgressBar Value="42" Maximum="100" Height="6" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================================================================= -->
                <!-- 2. DESK & SHIFTS VIEW                                             -->
                <!-- ================================================================= -->
                <Grid x:Name="DeskView" Grid.Row="0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="32,24">
                            <TextBlock Text="Desk &amp; Shift Management" Style="{StaticResource DisplayHeading}" />
                            <TextBlock x:Name="ShiftStatusText" Margin="0,6,0,0" Style="{StaticResource MonoData}"
                                       FontSize="12" Text="NO SHIFT OPEN" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OpenShiftButton" Content="Open Shift…" Style="{StaticResource GoldButton}" Click="OpenShift_Click" />
                                <Button x:Name="CloseShiftButton" Grid.Column="1" Content="Close Shift (Z-Report)…" Margin="10,0,0,0" Style="{StaticResource GhostButton}" Click="CloseShift_Click" IsEnabled="False" />
                                <Button x:Name="PrintXReportButton" Grid.Column="2" Content="Print X-Report" Margin="10,0,0,0" Style="{StaticResource GhostButton}" Click="PrintXReport_Click" IsEnabled="False" />
                            </Grid>

                            <TextBlock Text="WAITING GUESTS" Style="{StaticResource CapsLabel}" Margin="0,32,0,8" />
                            <ItemsControl x:Name="WaitlistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RaisedBrush}" Padding="12,8" Margin="0,0,0,6" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding GuestName}" />
                                                    <TextBlock Style="{StaticResource MonoData}" FontSize="11" Foreground="{StaticResource GhostBrush}">
                                                        <Run Text="{Binding PartySize, Mode=OneWay}" /><Run Text=" guest(s) · since " /><Run Text="{Binding EnqueuedAt.Hour, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding EnqueuedAt.Minute, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Seat…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SeatGuest_Click" />
                                                <Button Grid.Column="2" Content="Skip" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SkipGuest_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WaitNameInput" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="12" />
                                <TextBox x:Name="WaitPartyInput" Grid.Column="2" Width="44" Text="1" MaxLength="2" FontSize="12" />
                                <TextBox x:Name="WaitContactInput" Grid.Column="4" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="12" />
                                <Button x:Name="AddWaitGuestButton" Grid.Column="6" Content="Add Guest" Style="{StaticResource GhostButton}" Click="AddWaitGuest_Click" />
                            </Grid>

                            <TextBlock Text="HARDWARE &amp; ACCESSORY LOANS" Style="{StaticResource CapsLabel}" Margin="0,32,0,8" />
                            <ItemsControl x:Name="LoanItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RaisedBrush}" Padding="12,8" Margin="0,0,0,6" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding ItemName}" />
                                                    <TextBlock Style="{StaticResource MonoData}" FontSize="11" Foreground="{StaticResource GhostBrush}">
                                                        <Run Text="Deposit: " /><Run Text="{Binding DepositAmount, Mode=OneWay}" /><Run Text=" · Held by: " /><Run Text="{Binding HeldBy, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Returned" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ReturnLoan_Click" />
                                                <Button Grid.Column="2" Content="Forfeit Deposit" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ForfeitLoan_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LoanItemInput" Style="{StaticResource AppTextBox}" MaxLength="120" FontSize="12" />
                                <TextBox x:Name="LoanDepositInput" Grid.Column="2" Width="64" Text="0" MaxLength="8" FontSize="12" />
                                <TextBox x:Name="LoanHeldInput" Grid.Column="4" Width="110" MaxLength="120" FontSize="12" />
                                <Button x:Name="LoanItemButton" Grid.Column="6" Content="Loan Item" Style="{StaticResource GhostButton}" Click="LoanItem_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================================================================= -->
                <!-- 3. POS & SALES VIEW                                               -->
                <!-- ================================================================= -->
                <Grid x:Name="SalesView" Grid.Row="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="24,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Retail POS Catalog" Style="{StaticResource DisplayHeading}" />
                            <Grid Grid.Row="1" Margin="0,12,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PosSearchBox" Style="{StaticResource AppTextBox}" FontSize="12" TextChanged="PosSearch_TextChanged" />
                                <ComboBox x:Name="PosCategoryFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="PosCategory_SelectionChanged" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PosProductGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1" Width="170" Height="100" Margin="0,0,10,10" Padding="10"
                                                    CornerRadius="3" Cursor="Hand" MouseLeftButtonUp="PosProductTile_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Category}" Style="{StaticResource CapsLabel}" FontSize="9" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="1">
                                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Style="{StaticResource MonoData}" Foreground="{StaticResource GoldBrush}" FontSize="13" />
                                                        <TextBlock Text="{Binding StockQty, StringFormat={}Stock: {0}}" Style="{StaticResource MonoData}" FontSize="10" Foreground="{StaticResource GhostBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Order Summary" Style="{StaticResource DisplayHeading}" FontSize="15" />
                                <Button Content="Clear Cart" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="PosClearCart_Click" />
                            </Grid>

                            <DataGrid x:Name="PosCartGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                                      BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                                      AlternatingRowBackground="{StaticResource RaisedBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="45" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="65" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:C}}" Width="70" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Margin="0,14,0,14">
                                <Grid Margin="0,2">
                                    <TextBlock Text="Subtotal:" Style="{StaticResource BodyText}" FontSize="12" />
                                    <TextBlock x:Name="PosSubtotalText" Text="$0.00" Style="{StaticResource MonoData}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Discount ($):" Style="{StaticResource BodyText}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox x:Name="PosDiscountInput" Width="70" Text="0.00" Style="{StaticResource AppTextBox}" HorizontalAlignment="Right" TextChanged="PosDiscount_TextChanged" />
                                </Grid>
                                <Separator Background="{StaticResource LineBrush}" Margin="0,6" />
                                <Grid Margin="0,2">
                                    <TextBlock Text="Total Due:" Style="{StaticResource DisplayHeading}" FontSize="16" />
                                    <TextBlock x:Name="PosTotalText" Text="$0.00" Style="{StaticResource DisplayHeading}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="PAYMENT TENDER" Style="{StaticResource CapsLabel}" Margin="0,10,0,4" />
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CASH" Style="{StaticResource CapsLabel}" FontSize="9" />
                                        <TextBox x:Name="PosPaidCash" Text="0.00" Style="{StaticResource AppTextBox}" TextChanged="PosTender_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CARD" Style="{StaticResource CapsLabel}" FontSize="9" />
                                        <TextBox x:Name="PosPaidCard" Text="0.00" Style="{StaticResource AppTextBox}" TextChanged="PosTender_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="QR" Style="{StaticResource CapsLabel}" FontSize="9" />
                                        <TextBox x:Name="PosPaidQr" Text="0.00" Style="{StaticResource AppTextBox}" TextChanged="PosTender_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="Change Due:" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PosChangeText" Text="$0.00" Style="{StaticResource MonoData}" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <Button Grid.Row="3" Content="Complete POS Sale &amp; Print Receipt" Style="{StaticResource GoldButton}"
                                    Height="38" Click="PosCompleteSale_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- 4. VOUCHERS / TICKETS VIEW                                        -->
                <!-- ================================================================= -->
                <Grid x:Name="TicketsView" Grid.Row="0" Visibility="Collapsed" Margin="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Vouchers &amp; Ticket Codes" Style="{StaticResource DisplayHeading}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Sell Single Voucher…" Style="{StaticResource GoldButton}" Margin="0,0,8,0" Click="SellTicket_Click" />
                            <Button Content="Batch Generate…" Style="{StaticResource GhostButton}" Click="BatchGenerateTickets_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <CheckBox x:Name="TicketsUnusedOnlyCheck" Content="Show unused vouchers only" IsChecked="True"
                                  Foreground="{StaticResource GhostBrush}" Checked="TicketsFilter_Changed" Unchecked="TicketsFilter_Changed" />
                        <Button Content="Void Selected (Manager PIN)…" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="VoidTicket_Click" />
                    </Grid>

                    <DataGrid x:Name="TicketsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                              BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                              AlternatingRowBackground="{StaticResource RaisedBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="Minutes" Binding="{Binding DurationMinutes}" Width="75" />
                            <DataGridTextColumn Header="Credit" Binding="{Binding CreditAmount, StringFormat={}{0:C}}" Width="80" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="80" />
                            <DataGridCheckBoxColumn Header="Used" Binding="{Binding IsUsed}" Width="60" />
                            <DataGridTextColumn Header="Used At" Binding="{Binding UsedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchRef}" Width="110" />
                            <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ================================================================= -->
                <!-- 5. MEMBERS CLUB VIEW                                              -->
                <!-- ================================================================= -->
                <Grid x:Name="MembersView" Grid.Row="0" Visibility="Collapsed" Margin="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Members Club Management" Style="{StaticResource DisplayHeading}" />
                        <Button Content="New Member…" Style="{StaticResource GoldButton}" HorizontalAlignment="Right" Click="AddMember_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MemberSearchBox" Style="{StaticResource AppTextBox}" TextChanged="MemberSearch_TextChanged" />
                        <Button Grid.Column="2" Content="Top-up Money / Time…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="MemberTopUp_Click" />
                        <Button Grid.Column="3" Content="Toggle Freeze" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="MemberFreeze_Click" />
                    </Grid>

                    <DataGrid x:Name="MembersGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                              BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                              AlternatingRowBackground="{StaticResource RaisedBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code / ID" Binding="{Binding Code}" Width="100" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                            <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="80" />
                            <DataGridTextColumn Header="Cash Balance" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="100" />
                            <DataGridTextColumn Header="Time (Min)" Binding="{Binding TimeBalanceMinutes}" Width="90" />
                            <DataGridTextColumn Header="Total Spent" Binding="{Binding TotalSpent, StringFormat={}{0:C}}" Width="100" />
                            <DataGridCheckBoxColumn Header="Frozen" Binding="{Binding IsFrozen}" Width="70" />
                            <DataGridTextColumn Header="Joined" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ================================================================= -->
                <!-- 6. INVENTORY & STOCK VIEW                                         -->
                <!-- ================================================================= -->
                <Grid x:Name="InventoryView" Grid.Row="0" Visibility="Collapsed" Margin="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Inventory &amp; Stock Levels" Style="{StaticResource DisplayHeading}" />

                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InvSearchBox" Style="{StaticResource AppTextBox}" TextChanged="InvSearch_TextChanged" />
                        <ComboBox x:Name="InvCategoryFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="InvCategory_SelectionChanged" />
                        <Button Grid.Column="3" Content="Adjust Stock…" Style="{StaticResource GhostButton}" Click="StockAdjust_Click" />
                    </Grid>

                    <DataGrid x:Name="InventoryGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                              BorderBrush="{StaticResource LineBrush}" RowBackground="{StaticResource PanelBrush}"
                              AlternatingRowBackground="{StaticResource RaisedBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="90" />
                            <DataGridTextColumn Header="Stock Qty" Binding="{Binding StockQuantity}" Width="90" />
                            <DataGridTextColumn Header="Track Stock" Binding="{Binding TrackStock}" Width="90" />
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" />
