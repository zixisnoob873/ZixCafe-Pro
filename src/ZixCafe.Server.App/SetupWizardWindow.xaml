<Window x:Class="ZixCafe.Server.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZixCafe Pro — First-Run Setup Wizard"
        Width="640" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="ThreeDBorderWindow"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Path Width="28" Height="28" Fill="{StaticResource GoldBrush}"
                      Data="{StaticResource ZixBoltGeometry}" Stretch="Uniform" />
                <TextBlock Margin="12,0,0,0" Text="WELCOME TO ZIXCAFE PRO" VerticalAlignment="Center"
                           Style="{StaticResource DisplayHeading}" FontSize="18"
                           Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,20" TextWrapping="Wrap" Style="{StaticResource BodyText}" FontSize="13"
                       Foreground="{StaticResource GhostBrush}"
                       Text="Configure your venue's core billing preferences and create the primary administrator account. All settings can be adjusted later in the Settings tab." />
        </StackPanel>

        <Separator Grid.Row="1" Background="{StaticResource LineBrush}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="VENUE NAME" Style="{StaticResource CapsLabel}" />
                <TextBox x:Name="VenueNameBox" Text="My Esports Lounge" Style="{StaticResource AppTextBox}" Margin="0,4,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENCY CODE" Style="{StaticResource CapsLabel}" />
                        <TextBox x:Name="CurrencyCodeBox" Text="USD" Style="{StaticResource AppTextBox}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SYMBOL" Style="{StaticResource CapsLabel}" />
                        <TextBox x:Name="CurrencySymbolBox" Text="$" Style="{StaticResource AppTextBox}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="LOCALE" Style="{StaticResource CapsLabel}" />
                        <TextBox x:Name="LocaleBox" Text="en-US" Style="{StaticResource AppTextBox}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DEFAULT OPENING FLOAT" Style="{StaticResource CapsLabel}" />
                        <TextBox x:Name="OpeningFloatBox" Text="50.00" Style="{StaticResource AppTextBox}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TAX RATE (%)" Style="{StaticResource CapsLabel}" />
                        <TextBox x:Name="TaxRateBox" Text="0.00" Style="{StaticResource AppTextBox}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ADMINISTRATOR ACCOUNT" Style="{StaticResource DisplayHeading}" FontSize="14" Margin="0,8,0,8" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ADMIN USERNAME" Style="{StaticResource CapsLabel}" />
                        <TextBox x:Name="AdminUserBox" Text="admin" Style="{StaticResource AppTextBox}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ADMIN PIN (4+ DIGITS)" Style="{StaticResource CapsLabel}" />
                        <PasswordBox x:Name="AdminPinBox" Password="1234" MaxLength="16"
                                     Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                     Padding="10,6" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="SeedSampleCheckBox" Content="Load sample terminals, tariffs, and catalog items [SAMPLE labeled]"
                          IsChecked="True" Foreground="{StaticResource GhostBrush}" FontSize="12" Margin="0,4,0,0" />

                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Style="{StaticResource BodyText}" FontSize="12"
                           Foreground="{StaticResource AlertBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Button x:Name="CompleteButton" Content="Complete Setup &amp; Launch" Style="{StaticResource GoldButton}"
                    HorizontalAlignment="Right" Click="CompleteSetup_Click" />
        </Border>
    </Grid>
</Window>
