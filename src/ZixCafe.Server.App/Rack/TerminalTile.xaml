<UserControl x:Class="ZixCafe.Server.App.Rack.TerminalTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="214" Height="118" Margin="0,0,12,12" Cursor="Hand">
    <Border x:Name="Card" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource TileRadius}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status Accent Rail -->
            <Rectangle x:Name="Rail" Grid.Column="0" Width="3" Fill="Transparent" Margin="0,8" RadiusX="1.5" RadiusY="1.5" />

            <Grid Grid.Column="1" Margin="10,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Monitor Icon + Name + Status Pill -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0"
                          Fill="{Binding StatusBrush}"
                          Data="{StaticResource IconScreen}"
                          Stretch="Uniform" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CapsLabel}"
                               Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    
                    <Border Grid.Column="2" Style="{StaticResource StatusPill}"
                            VerticalAlignment="Center" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Margin="0,0,4,0"
                                     Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CapsLabel}"
                                       FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Time Countdown + Amount -->
                <Grid Grid.Row="1" Margin="0,4,0,2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CapsLabel}"
                                   FontSize="8.5" Foreground="{StaticResource GhostBrush}" Margin="0,0,0,1" />
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoData}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource MonoData}"
                               FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Foreground="{StaticResource GhostBrush}" />
                </Grid>

                <!-- Row 2: Zone + Mini Telemetry Indicator -->
                <Grid Grid.Row="2">
                    <TextBlock Text="{Binding ZoneName}" Style="{StaticResource CapsLabel}"
                               FontSize="9.5" Foreground="{StaticResource GhostBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CpuTemp, StringFormat='CPU: {0}°C'}" Style="{StaticResource MonoData}"
                               FontSize="9" Foreground="{StaticResource GhostBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
