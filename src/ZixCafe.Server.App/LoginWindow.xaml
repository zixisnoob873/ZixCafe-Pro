<Window x:Class="ZixCafe.Server.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZixCafe Pro — Sign in"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <StackPanel Margin="28">
        <StackPanel Orientation="Horizontal">
            <Path Width="22" Height="22" Fill="{StaticResource GoldBrush}"
                  Data="{StaticResource ZixBoltGeometry}" Stretch="Uniform" />
            <TextBlock Margin="10,0,0,0" Text="ZIXCAFE PRO" VerticalAlignment="Center"
                       Style="{StaticResource DisplayHeading}" FontSize="14"
                       Foreground="{StaticResource InkBrush}" />
        </StackPanel>

        <TextBlock Text="CASHIER SIGN-IN" Style="{StaticResource CapsLabel}" Margin="0,18,0,8" />
        <TextBox x:Name="NameInput" Style="{StaticResource AppTextBox}" FontSize="14" />
        <TextBlock Text="PIN" Style="{StaticResource CapsLabel}" Margin="0,12,0,8" />
        <PasswordBox x:Name="PinInput" FontSize="14" Padding="10,8" Background="{StaticResource RaisedBrush}"
                     Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}"
                     BorderThickness="1" KeyDown="PinInput_KeyDown" />
        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource AlertBrush}"
                   Style="{StaticResource BodyText}" FontSize="12" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource GoldButton}"
                HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="SignIn_Click" />
        <TextBlock Text="sample cashier: demo / 0000" Style="{StaticResource CapsLabel}"
                   FontSize="10" Foreground="{StaticResource GhostBrush}" Margin="0,14,0,0" />
    </StackPanel>
</Window>
